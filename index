    // Генерация детерминированного криптографического контрольного кода (RAT-XXXX-XXXX-XXXX)
    function computeVerificationCode({ studentName, score, total, durationStr, dateStr }) {
      const normalizedName = String(studentName || '').trim().toLowerCase().replace(/\s+/g, ' ');
      const payload = `${REPORT_SALT}|${normalizedName}|${Number(score)}|${Number(total)}|${String(durationStr).trim()}|${String(dateStr).trim()}`;

      let h1 = 0x811c9dc5;
      let h2 = 0x1b873593;
      let h3 = 0x5bd1e995;

      for (let i = 0; i < payload.length; i++) {
        const ch = payload.charCodeAt(i);
        h1 ^= ch;
        h1 = Math.imul(h1, 0x01000193);

        h2 = Math.imul(h2 ^ ch, 0x85ebca6b);
        h2 ^= h2 >>> 13;

        h3 = ((h3 << 5) + h3) ^ ch;
      }

      const part1 = ((h1 >>> 0) & 0xffff).toString(16).toUpperCase().padStart(4, '0');
      const part2 = ((h2 >>> 0) & 0xffff).toString(16).toUpperCase().padStart(4, '0');
      const part3 = ((h3 >>> 0) & 0xffff).toString(16).toUpperCase().padStart(4, '0');

      return `RAT-${part1}-${part2}-${part3}`;
    }

    function renderMath(element = document.body) {
      if (window.renderMathInElement) {
        renderMathInElement(element, {
          delimiters: [
