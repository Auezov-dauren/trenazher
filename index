<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Персонализированный тренажер: Действия над рациональными числами (6 класс)</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- KaTeX CSS & JS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" crossorigin="anonymous"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js" crossorigin="anonymous"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
        },
      },
    };
  </script>
  <style>
    body {
      background-color: #f8fafc;
      color: #0f172a;
      font-family: 'Inter', sans-serif;
    }
    .katex {
      font-size: 1.06em;
    }
    .option-btn {
      transition: all 0.18s ease;
    }
    .option-btn:not(:disabled):hover {
      border-color: #2563eb;
      background-color: #eff6ff;
      transform: translateY(-1px);
    }
  </style>
</head>
<body class="min-h-screen antialiased selection:bg-blue-100 selection:text-blue-900">

  <!-- Верхняя панель навигации / статус-бар -->
  <header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-slate-200 shadow-sm">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-extrabold text-lg shadow-sm">
          ℚ
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">
              Математика • 6 класс • Подготовка к СОР
            </span>
            <span id="modeBadge" class="hidden text-xs font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">
              Работа над ошибками
            </span>
          </div>
          <h1 class="text-sm sm:text-base font-bold text-slate-900 mt-0.5">
            Действия над рациональными числами
          </h1>
        </div>
      </div>

      <!-- Индикатор прогресса и таймера (активен во время теста) -->
      <div id="liveStatsBar" class="hidden flex items-center gap-4 sm:gap-6">
        <div class="text-right">
          <div class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold">Прогресс</div>
          <div class="text-sm font-bold text-slate-800">
            <span id="answeredCount" class="text-indigo-600">0</span> / <span id="totalCount">18</span>
          </div>
        </div>
        <div class="h-8 w-px bg-slate-200"></div>
        <div class="text-right">
          <div class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold">Время</div>
          <div id="timerDisplay" class="text-sm font-mono font-bold text-slate-800 bg-slate-100 px-2.5 py-1 rounded-lg">
            00:00
          </div>
        </div>
      </div>

      <!-- Кнопка верификатора для учителя -->
      <button
        id="openVerifierBtn"
        type="button"
        class="text-xs font-semibold text-slate-600 hover:text-indigo-700 bg-slate-100 hover:bg-indigo-50 border border-slate-200 hover:border-indigo-200 px-3 py-2 rounded-xl transition flex items-center gap-1.5 cursor-pointer"
        title="Проверить подлинность отчета ученика"
      >
        <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        <span class="hidden sm:inline">Проверка отчета (Учителю)</span>
        <span class="sm:hidden">Учителю</span>
      </button>
    </div>
    <!-- Тонкая полоса прогресса -->
    <div id="progressBarContainer" class="hidden w-full bg-slate-100 h-1.5">
      <div id="progressBarFill" class="bg-indigo-600 h-1.5 transition-all duration-300" style="width: 0%"></div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <!-- ЭКРАН 1: АВТОРИЗАЦИЯ И СТАРТ -->
    <section id="startScreen" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold mb-4 border border-indigo-100">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Data-Driven персонализация обучения • 6 класс
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight">
          Персонализированный тренажер: Действия над рациональными числами
        </h2>
        <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
          <strong class="text-slate-800">Цель обучения (СОР):</strong> отработка правил умножения и деления рациональных чисел (десятичных, обыкновенных и смешанных дробей с разными и одинаковыми отрицательными знаками), перевода бесконечных периодических десятичных дробей в обыкновенные и решения текстовых задач составлением уравнения.
        </p>

        <!-- Сетка структуры СОР (5 блоков, 18 заданий) -->
        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
            <div class="text-xs font-bold text-indigo-600 uppercase">Блок 1 • 4 задания</div>
            <div class="text-sm font-semibold text-slate-800 mt-0.5">Умножение рациональных чисел</div>
            <div class="text-xs text-slate-500 mt-1">Десятичные и обыкновенные дроби (разные и отрицательные знаки)</div>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
            <div class="text-xs font-bold text-indigo-600 uppercase">Блок 2 • 4 задания</div>
            <div class="text-sm font-semibold text-slate-800 mt-0.5">Деление рациональных чисел</div>
            <div class="text-xs text-slate-500 mt-1">Десятичные и смешанные дроби с разными и одинаковыми знаками</div>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
            <div class="text-xs font-bold text-indigo-600 uppercase">Блок 3 • 3 задания</div>
            <div class="text-sm font-semibold text-slate-800 mt-0.5">Чистая периодическая дробь</div>
            <div class="text-xs text-slate-500 mt-1">Перевод в обыкновенную: 1, 2 и 3 цифры в периоде</div>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
            <div class="text-xs font-bold text-indigo-600 uppercase">Блок 4 • 4 задания</div>
            <div class="text-sm font-semibold text-slate-800 mt-0.5">Смешанная периодическая дробь</div>
            <div class="text-xs text-slate-500 mt-1">Структуры (1+1), (1+2), (2+1) и (2+2)</div>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 sm:col-span-2 lg:col-span-2">
            <div class="text-xs font-bold text-indigo-600 uppercase">Блок 5 • 3 задания</div>
            <div class="text-sm font-semibold text-slate-800 mt-0.5">Текстовые задачи на рациональные числа</div>
            <div class="text-xs text-slate-500 mt-1">Составление линейных уравнений с отрицательными числами и дробями</div>
          </div>
        </div>

        <!-- Форма ввода ФИО -->
        <div class="mt-8 pt-6 border-t border-slate-200">
          <label for="studentNameInput" class="block text-sm font-semibold text-slate-800 mb-2">
            Фамилия и Имя ученика <span class="text-red-600">*</span>
          </label>
          <div class="flex flex-col sm:flex-row gap-3">
            <input
              type="text"
              id="studentNameInput"
              placeholder="Например: Серикова Амина"
              class="flex-1 rounded-xl border border-slate-300 px-4 py-3 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 text-base"
              autocomplete="name"
            />
            <button
              id="startBtn"
              type="button"
              class="rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold px-7 py-3.5 shadow-sm transition flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Начать тестирование</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
            </button>
          </div>
          <p id="nameErrorMsg" class="hidden mt-2 text-sm text-red-600 font-medium">
            Пожалуйста, введите Фамилию и Имя перед началом тестирования.
          </p>
          <p class="mt-3 text-xs text-slate-500 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            Включена антисписок-механика: варианты заданий и порядок ответов формируются индивидуально для каждого запуска.
          </p>
        </div>
      </div>
    </section>

    <!-- ЭКРАН 2: ДИАГНОСТИЧЕСКИЙ ОТЧЕТ (появляется сверху после завершения) -->
    <section id="reportSection" class="hidden mb-8 space-y-6">
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-200">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold border border-emerald-200 mb-2">
              Диагностический отчет сформирован
            </div>
            <h2 id="reportTitle" class="text-2xl font-extrabold text-slate-900">
              Результаты тестирования
            </h2>
            <p class="text-sm text-slate-600 mt-1">
              Ученик: <strong id="repStudentName" class="text-slate-900"></strong> • Дата: <span id="repDate"></span> • Время: <strong id="repDuration" class="text-slate-900"></strong>
            </p>
          </div>

          <!-- Итоговый бейдж балла -->
          <div class="flex items-center gap-4 bg-slate-50 border border-slate-200 rounded-2xl p-4">
            <div class="text-center">
              <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Баллы</div>
              <div class="text-2xl sm:text-3xl font-extrabold text-indigo-600">
                <span id="repScore">0</span><span class="text-lg text-slate-400 font-semibold">/<span id="repTotal">18</span></span>
              </div>
            </div>
            <div class="h-10 w-px bg-slate-200"></div>
            <div class="text-center">
              <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Процент</div>
              <div id="repPercent" class="text-2xl sm:text-3xl font-extrabold text-slate-900">0%</div>
            </div>
            <div class="h-10 w-px bg-slate-200"></div>
            <div>
              <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Уровень СОР</div>
              <div id="repLevelBadge" class="mt-0.5 inline-block px-3 py-1 rounded-lg text-xs font-bold">
                —
              </div>
            </div>
          </div>
        </div>

        <!-- Анализ по 5 дескрипторам (типичные ошибки) -->
        <div id="descriptorAnalysisWrapper" class="mt-6">
          <h3 class="text-base font-bold text-slate-900 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
            Диагностика по дескрипторам (анализ типичных ошибок)
          </h3>
          <div id="descriptorsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <!-- Заполняется динамически -->
          </div>
          <div id="typicalErrorsSummary" class="mt-4 p-4 rounded-xl bg-amber-50 border border-amber-200 text-sm text-amber-900 hidden">
            <!-- Текстовое резюме западающих тем -->
          </div>
        </div>

        <!-- Панель действий: Работа над ошибками и Сохранение отчета -->
        <div class="mt-6 pt-6 border-t border-slate-200 flex flex-wrap items-center gap-3">
          <button
            id="remediationBtn"
            type="button"
            class="hidden rounded-xl bg-amber-500 hover:bg-amber-600 active:bg-amber-700 text-white font-semibold px-5 py-3 shadow-sm transition flex items-center gap-2 cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            <span id="remediationBtnText">Работа над ошибками</span>
          </button>

          <button
            id="saveReportBtn"
            type="button"
            class="rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold px-6 py-3 shadow-sm transition flex items-center gap-2 cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            <span>Сохранить отчет</span>
          </button>

          <button
            id="copySummaryBtn"
            type="button"
            class="rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-semibold px-4 py-3 transition flex items-center gap-2 cursor-pointer"
          >
            <svg class="w-5 h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
            <span>Скопировать сводку</span>
          </button>
        </div>

        <!-- Плашка контрольного кода подлинности -->
        <div class="mt-4 p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex flex-wrap items-center justify-between gap-2 text-xs">
          <div class="flex items-center gap-2 text-slate-600">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            <span>Контрольный код подлинности отчета:</span>
          </div>
          <code id="repVerificationCode" class="font-mono font-bold text-slate-900 bg-white px-2.5 py-1 rounded-lg border border-slate-300 select-all">
            RAT-0000-0000-0000
          </code>
        </div>

        <!-- Подробный разбор ошибок -->
        <div id="mistakesReviewContainer" class="mt-8 pt-6 border-t border-slate-200 hidden">
          <h3 class="text-lg font-bold text-red-700 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            Разбор допущенных ошибок и пошаговые решения
          </h3>
          <div id="mistakesList" class="space-y-4">
            <!-- Карточки ошибок с решениями -->
          </div>
        </div>

        <!-- Сообщение при 100% результате -->
        <div id="perfectScoreBanner" class="hidden mt-6 p-5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900">
          <div class="font-bold text-base">Превосходный результат! Все задания выполнены безошибочно.</div>
          <p class="text-sm mt-1 text-emerald-800">Вы полностью готовы к суммативному оцениванию за раздел «Действия над рациональными числами». Нажмите «Сохранить отчет», чтобы показать результат учителю.</p>
        </div>
      </div>
    </section>

    <!-- ЭКРАН 3: КОНТЕЙНЕР ЗАДАНИЙ -->
    <section id="quizSection" class="hidden space-y-8">
      <!-- Информационная плашка текущего режима -->
      <div id="activeStudentBanner" class="bg-white rounded-xl border border-slate-200 px-5 py-3.5 flex flex-wrap items-center justify-between gap-2 shadow-sm">
        <div class="text-sm text-slate-600">
          Выполняет: <strong id="bannerStudentName" class="text-slate-900"></strong>
        </div>
        <div class="text-xs text-slate-500">
          Выберите один верный ответ в каждом задании
        </div>
      </div>

      <!-- Сюда динамически рендерятся блоки и карточки заданий -->
      <div id="questionsContainer" class="space-y-8"></div>

      <!-- Нижняя панель с кнопкой «Завершить» -->
      <div id="finishPanel" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-sm text-slate-600 text-center sm:text-left">
          Проверьте выбранные ответы. После нажатия кнопки <strong>«Завершить»</strong> внесение изменений станет недоступным.
        </div>
        <button
          id="finishBtn"
          type="button"
          class="w-full sm:w-auto rounded-xl bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-bold px-8 py-3.5 shadow-sm transition flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span id="finishBtnText">Завершить</span>
        </button>
      </div>
    </section>

  </main>

  <!-- Модальное окно подтверждения завершения -->
  <div id="confirmModal" class="hidden fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-200">
      <h3 class="text-lg font-bold text-slate-900">Завершить тестирование?</h3>
      <p id="confirmModalText" class="mt-2 text-sm text-slate-600 leading-relaxed"></p>
      <div class="mt-6 flex items-center justify-end gap-3">
        <button id="cancelFinishBtn" type="button" class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer">
          Вернуться к заданиям
        </button>
        <button id="confirmFinishBtn" type="button" class="rounded-xl bg-emerald-600 hover:bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white cursor-pointer">
          Да, завершить
        </button>
      </div>
    </div>
