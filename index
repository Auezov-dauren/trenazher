    (function verifyIntegrity() {
      const salt = '${REPORT_SALT}';
      const name = document.getElementById('fieldName').textContent.trim().toLowerCase().replace(/\\s+/g, ' ');
      const score = Number(document.getElementById('fieldScore').textContent.trim());
