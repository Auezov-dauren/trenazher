      tempTextarea.select();
      try {
        document.execCommand('copy');
        showToast('Сводка скопирована в буфер обмена');
      } catch (err) {
        showToast('Не удалось скопировать текст');
      }
      document.body.removeChild(tempTextarea);
    }

    // =========================================================================
    // ИНИЦИАЛИЗАЦИЯ СОБЫТИЙ
    // =========================================================================
    window.addEventListener('DOMContentLoaded', () => {
      renderMath(document.body);

      const startBtn = document.getElementById('startBtn');
      const nameInput = document.getElementById('studentNameInput');
      const nameError = document.getElementById('nameErrorMsg');

      startBtn.addEventListener('click', () => {
        const val = nameInput.value.trim();
        if (val.length < 2) {
          nameError.classList.remove('hidden');
          nameInput.focus();
          return;
        }
        nameError.classList.add('hidden');
        state.studentName = val;
        startSession('main');
      });

      nameInput.addEventListener('keydown', e => {
        if (e.key === 'Enter') startBtn.click();
      });

      document.getElementById('finishBtn').addEventListener('click', handleFinishClick);
      document.getElementById('cancelFinishBtn').addEventListener('click', () => {
        document.getElementById('confirmModal').classList.add('hidden');
      });
      document.getElementById('confirmFinishBtn').addEventListener('click', finalizeTest);

      document.getElementById('remediationBtn').addEventListener('click', () => {
        const currentRep = state.mode === 'main' ? state.mainReport : state.remediationReport;
        if (!currentRep || currentRep.wrongQuestions.length === 0) return;

        const wrongSlotIds = currentRep.wrongQuestions.map(q => q.slotId);
        const prevVariants = {};
        currentRep.wrongQuestions.forEach(q => {
          prevVariants[q.slotId] = q.variantIndex;
        });

        startSession('remediation', wrongSlotIds, prevVariants);
        showToast('Сгенерированы новые варианты по вашим ошибкам');
      });

      document.getElementById('saveReportBtn').addEventListener('click', downloadTeacherReport);
      document.getElementById('copySummaryBtn').addEventListener('click', copySummaryToClipboard);

      const verifierModal = document.getElementById('verifierModal');
      document.getElementById('openVerifierBtn').addEventListener('click', () => {
        const activeRep = state.mainReport || state.remediationReport;
        if (activeRep) {
          document.getElementById('verNameInput').value = activeRep.studentName;
          document.getElementById('verScoreInput').value = activeRep.score;
          document.getElementById('verTotalInput').value = activeRep.total;
          document.getElementById('verDurationInput').value = activeRep.durationStr;
          document.getElementById('verDateInput').value = activeRep.dateStr;
          document.getElementById('verCodeInput').value = activeRep.verificationCode;
        }
        document.getElementById('verResultBox').classList.add('hidden');
        verifierModal.classList.remove('hidden');
      });

      document.getElementById('closeVerifierBtn').addEventListener('click', () => {
        verifierModal.classList.add('hidden');
      });

      document.getElementById('runVerifyBtn').addEventListener('click', () => {
        const name = document.getElementById('verNameInput').value.trim();
        const score = document.getElementById('verScoreInput').value.trim();
        const total = document.getElementById('verTotalInput').value.trim();
        const duration = document.getElementById('verDurationInput').value.trim();
        const dateStr = document.getElementById('verDateInput').value.trim();
        const inputCode = document.getElementById('verCodeInput').value.trim().toUpperCase();
        const resBox = document.getElementById('verResultBox');

        if (!name || score === '' || !total || !duration || !dateStr || !inputCode) {
          resBox.className = 'p-3.5 rounded-xl text-xs font-semibold bg-amber-50 border border-amber-200 text-amber-900';
          resBox.textContent = 'Заполните все поля из отчета ученика для проверки подлинности.';
          resBox.classList.remove('hidden');
          return;
        }

        const expectedCode = computeVerificationCode({
          studentName: name,
          score: Number(score),
          total: Number(total),
          durationStr: duration,
          dateStr: dateStr
        });

        resBox.classList.remove('hidden');
        if (expectedCode === inputCode) {
          resBox.className = 'p-3.5 rounded-xl text-xs font-semibold bg-emerald-50 border border-emerald-200 text-emerald-900';
          resBox.textContent = `✓ ПОДЛИННОСТЬ ПОДТВЕРЖДЕНА! Данные не изменялись (код ${expectedCode} валиден).`;
        } else {
          resBox.className = 'p-3.5 rounded-xl text-xs font-semibold bg-red-50 border border-red-200 text-red-900';
          resBox.textContent = '✕ ОШИБКА ПРОВЕРКИ: Контрольный код не совпадает! Вероятно, баллы, ФИО или время были изменены вручную.';
        }
      });
    });
  </script>
</body>
</html>
