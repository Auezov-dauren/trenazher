      const payload = salt + '|' + name + '|' + score + '|' + total + '|' + duration + '|' + dateStr;
      let h1 = 0x811c9dc5, h2 = 0x1b873593, h3 = 0x5bd1e995;
      for (let i = 0; i < payload.length; i++) {
        const ch = payload.charCodeAt(i);
        h1 ^= ch; h1 = Math.imul(h1, 0x01000193);
        h2 = Math.imul(h2 ^ ch, 0x85ebca6b); h2 ^= h2 >>> 13;
        h3 = ((h3 << 5) + h3) ^ ch;
      }
      const expected = 'RAT-' +
        ((h1 >>> 0) & 0xffff).toString(16).toUpperCase().padStart(4, '0') + '-' +
        ((h2 >>> 0) & 0xffff).toString(16).toUpperCase().padStart(4, '0') + '-' +
        ((h3 >>> 0) & 0xffff).toString(16).toUpperCase().padStart(4, '0');

      const banner = document.getElementById('integrityStatus');
      if (expected === storedCode) {
        banner.className = 'verify-banner verify-ok';
        banner.textContent = '✓ ПОДЛИННОСТЬ ПОДТВЕРЖДЕНА: Цифровая подпись (' + storedCode + ') полностью совпадает с данными протокола.';
