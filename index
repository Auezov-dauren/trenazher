    function generateQuestions(filterSlotIds = null, previousVariantIndices = {}) {
      const slotsToUse = filterSlotIds
        ? QUESTION_BANK.filter(item => filterSlotIds.includes(item.slotId))
        : QUESTION_BANK;

      return slotsToUse.map((slot, idx) => {
        let variantIndex = Math.floor(Math.random() * slot.variants.length);
        if (
          filterSlotIds &&
          slot.variants.length > 1 &&
          previousVariantIndices[slot.slotId] !== undefined &&
          variantIndex === previousVariantIndices[slot.slotId]
        ) {
          variantIndex = (variantIndex + 1) % slot.variants.length;
        }

        const chosenVariant = slot.variants[variantIndex];
        const indexedOptions = chosenVariant.options.map((optText, i) => ({
          text: optText,
          isCorrect: i === chosenVariant.correct
        }));
        const shuffledOptions = shuffleArray(indexedOptions);
        const newCorrectIndex = shuffledOptions.findIndex(o => o.isCorrect);

        return {
          displayNumber: idx + 1,
          slotId: slot.slotId,
          blockId: slot.blockId,
          blockTitle: slot.blockTitle,
          descriptor: slot.descriptor,
          variantIndex: variantIndex,
          question: chosenVariant.question,
          options: shuffledOptions.map(o => o.text),
          correct: newCorrectIndex,
          solution: chosenVariant.solution
        };
      });
    }

