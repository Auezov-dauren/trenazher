          `Вы ответили на ${answered} из ${total} заданий (осталось ${remaining}). Неотвеченные задания будут засчитаны как неверные. Вы уверены, что хотите завершить?`;
        document.getElementById('confirmModal').classList.remove('hidden');
      } else {
        finalizeTest();
      }
    }

    function finalizeTest() {
      document.getElementById('confirmModal').classList.add('hidden');
      state.isFinished = true;
      stopTimer();

      const durationStr = formatDuration(state.endTime - state.startTime);
      const now = new Date();
      const dateStr =
        now.toLocaleDateString('ru-RU') +
        ' ' +
        now.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });

      document.querySelectorAll('.option-btn').forEach(btn => {
        btn.disabled = true;
        btn.classList.remove('cursor-pointer');
        btn.classList.add('cursor-default');
      });

      let score = 0;
      const detailedResults = [];
      const wrongQuestions = [];

      state.activeQuestions.forEach(q => {
        const userOpt = state.userAnswers[q.slotId];
        const isCorrect = userOpt !== undefined && userOpt === q.correct;
        if (isCorrect) score++;

        const card = document.getElementById(`q-card-${q.slotId}`);
        const statusBadge = document.getElementById(`q-status-${q.slotId}`);
        const grid = document.getElementById(`options-grid-${q.slotId}`);

        statusBadge.classList.remove('hidden');
        if (isCorrect) {
          card.classList.add('border-emerald-300', 'bg-emerald-50/10');
          statusBadge.className = 'text-xs font-bold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800';
          statusBadge.textContent = '✓ Верно';
        } else {
          card.classList.add('border-red-300', 'bg-red-50/10');
          statusBadge.className = 'text-xs font-bold px-2.5 py-1 rounded-full bg-red-100 text-red-800';
          statusBadge.textContent = userOpt === undefined ? '✕ Нет ответа' : '✕ Ошибка';
          document.getElementById(`inline-solution-${q.slotId}`).classList.remove('hidden');
          wrongQuestions.push(q);
        }

        grid.querySelectorAll('.option-btn').forEach(btn => {
          const idx = Number(btn.dataset.opt);
          const letterSpan = btn.querySelector('.opt-letter');
          btn.classList.remove('border-indigo-600', 'bg-indigo-50/70', 'ring-2', 'ring-indigo-600/20');

          if (idx === q.correct) {
            btn.classList.remove('border-slate-200', 'bg-white');
            btn.classList.add('border-emerald-500', 'bg-emerald-50');
            letterSpan.classList.remove('bg-slate-100', 'text-slate-600', 'bg-indigo-600');
            letterSpan.classList.add('bg-emerald-600', 'text-white');
          } else if (idx === userOpt && !isCorrect) {
            btn.classList.remove('border-slate-200', 'bg-white');
            btn.classList.add('border-red-500', 'bg-red-50');
            letterSpan.classList.remove('bg-slate-100', 'text-slate-600', 'bg-indigo-600');
            letterSpan.classList.add('bg-red-600', 'text-white');
          } else {
            btn.classList.add('opacity-65');
          }
        });

        detailedResults.push({
          ...q,
          userOpt,
          userAnswerText: userOpt !== undefined ? q.options[userOpt] : 'Не дан ответ',
          correctAnswerText: q.options[q.correct],
          isCorrect
        });
      });

      const total = state.activeQuestions.length;
      const percent = Math.round((score / total) * 100);

      const blockStats = [];
      const blockIds = [...new Set(state.activeQuestions.map(q => q.blockId))];
      blockIds.forEach(bId => {
        const items = detailedResults.filter(r => r.blockId === bId);
        const blockCorrect = items.filter(r => r.isCorrect).length;
        const blockTotal = items.length;
        const blockPct = Math.round((blockCorrect / blockTotal) * 100);
        blockStats.push({
          blockId: bId,
          blockTitle: items[0].blockTitle,
          correct: blockCorrect,
          total: blockTotal,
          percent: blockPct
        });
      });

      const verificationCode = computeVerificationCode({
        studentName: state.studentName,
        score,
        total,
        durationStr,
        dateStr
      });

      const reportSnapshot = {
        mode: state.mode,
        studentName: state.studentName,
        startDateStr: state.startDateStr,
        dateStr,
        durationStr,
        score,
        total,
        percent,
        verificationCode,
        blockStats,
        detailedResults,
        wrongQuestions
      };

      if (state.mode === 'main') {
        state.mainReport = reportSnapshot;
      } else {
        state.remediationReport = reportSnapshot;
      }

      document.getElementById('finishPanel').classList.add('hidden');
      renderReportUI(reportSnapshot);
    }

